{
  "name": "openhome3d",
  "version": "0.2.0",
  "description": "Open-source cartoon-style (cel-shaded) multi-room home designer with a Neo-Brutalism UI — procedural seed-based layouts, 337 CC0 furniture models, model upload, and playful editing.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuyou-dev/OpenHome3D.git"
  },
  "keywords": [
    "home-design",
    "interior-design",
    "cel-shading",
    "toon-rendering",
    "neo-brutalism",
    "three.js",
    "react",
    "furniture",
    "procedural-generation"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "build:pages": "tsc && tsc -p tsconfig.node.json && vite build --base=/OpenHome3D/",
    "preview": "vite preview",
    "smoke": "tsx scripts/smoke-gen.ts",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "audit:ui": "node scripts/audit-ui-overflow.mjs",
    "assets": "node scripts/fetch-assets.mjs && node scripts/build-manifest.mjs",
    "doctor": "node scripts/doctor.mjs",
    "scan:public": "node scripts/public-scan.mjs",
    "companion:test": "node --test plugins/openhome3d-companion/tests/*.test.mjs",
    "smoke:editor": "node scripts/test-editor-state.mjs && tsx scripts/test-model-search.ts && tsx scripts/test-camera-fit.ts && node scripts/test-runtime.mjs && node scripts/test-editing-invariants.mjs",
    "smoke:interactions": "node scripts/test-interactions.mjs",
    "smoke:ai": "node --test scripts/test-ai-api.mjs",
    "check": "npm run build && npm run smoke && npm run smoke:editor && npm run smoke:ai",
    "smoke:ai-flow": "node scripts/test-ai-flow.mjs",
    "smoke:project": "node scripts/test-project-package.mjs",
    "check:ui": "npm run smoke:ui && npm run smoke:interactions && npm run smoke:project && npm run smoke:ai-flow && npm run audit:ui",
    "smoke:ai:live": "node scripts/test-ai-live.mjs",
    "smoke:pages": "npm run build:pages && node scripts/test-pages.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.7.0",
    "@react-three/postprocessing": "3.0.4",
    "idb-keyval": "6.3.0",
    "react": "19.2.8",
    "react-compare-slider": "^4.0.0",
    "react-dom": "19.2.8",
    "seedrandom": "3.0.5",
    "three": "0.185.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/seedrandom": "3.0.8",
    "@types/three": "0.185.2",
    "@vitejs/plugin-react": "5.2.0",
    "puppeteer-core": "^24.43.1",
    "tsx": "^4.23.1",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  }
}
